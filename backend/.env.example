# Local development (backend on the host, PostgreSQL from compose.dev.yml).
# Copy to backend/.env and use the same DB password as the root .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://labelmaker:change-me-db-password@localhost:5432/labelmaker
# Vite dev server
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_DISPLAY_NAME=Administrator

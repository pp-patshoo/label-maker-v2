# Copy to .env (never commit .env) and change every password below.

# Web port on the host
APP_PORT=8080
# Host interface to publish on (0.0.0.0 = all). On a LAN server set it to the server's LAN IP.
APP_BIND=0.0.0.0

# PostgreSQL (db container)
POSTGRES_USER=labelmaker
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=labelmaker

# First admin, created only when the users table is empty.
# This password is temporary: the admin must change it at first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_DISPLAY_NAME=Administrator

# Origin(s) the browser uses to open the app (comma-separated). Used for the CSRF Origin check.
# Must match the browser URL exactly, e.g. http://192.168.1.50:8080 (omit :80 when APP_PORT=80).
APP_ORIGIN=http://localhost:8080
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
